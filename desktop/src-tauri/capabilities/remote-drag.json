{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-drag",
  "description": "允许 DSH Web GUI（dsh web 子进程在 127.0.0.1/localhost 上提供，对 Tauri 属 remote origin）通过注入的左上角拖拽条拖动主窗口。仅放行拖拽相关命令，最小化 remote 暴露面。",
  "remote": {
    "urls": [
      "http://127.0.0.1",
      "http://127.0.0.1:3080",
      "http://localhost",
      "http://localhost:3080"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
