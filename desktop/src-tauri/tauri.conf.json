{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deepseek Harness",
  "version": "0.5.2",
  "identifier": "com.arcreel.dsh-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "pet",
        "url": "pet.html",
        "title": "Deepseek Harness 桌宠",
        "width": 260,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false,
        "shadow": false,
        "visible": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Deepseek Harness —— DeepSeek Harness 桌面客户端",
    "longDescription": "一键启动 DeepSeek Harness Web GUI 的桌面壳：自动拉起本地服务、托盘常驻、退出自动清理。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "embedded/dsh-desktop-app": "dsh-desktop-app/"
    }
  }
}
